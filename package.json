{
  "name": "netops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NetOps 网络拓扑学习与自由画布",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:boundary": "node scripts/check-public-boundary.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vue-flow/core": "1.48.2",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.3",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
